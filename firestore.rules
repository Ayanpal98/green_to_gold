rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Prototype: allow public read for DSS visibility
    function isPublic() {
      return true;
    }

    // District Resources: Public Read-only
    match /district_resources/{resourceId} {
      allow read: if isPublic();
      allow write: if false;
    }

    // Harvest Recommendations: Public Create/Read (History logs)
    match /harvest_recommendations/{recId} {
      allow read, create: if isPublic();
      allow update, delete: if false;
    }

    // SHG Activity: Public Read/Write for prototype
    match /shg_activity/{activityId} {
      allow read, create, update: if isPublic();
      allow delete: if false;
    }

    // DSS Alerts: Public Read, anyone can resolve in prototype
    match /dss_alerts/{alertId} {
      allow read: if isPublic();
      allow update: if isPublic() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
    }
  }
}
