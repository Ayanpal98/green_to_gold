{
  "entities": {
    "DistrictResource": {
      "title": "District Resource",
      "description": "Stock and coverage data for a specific district in Tripura.",
      "type": "object",
      "properties": {
        "district": { "type": "string" },
        "bamboo_stock_t": { "type": "number" },
        "coverage_pct": { "type": "number" },
        "status": { "type": "string", "enum": ["Healthy", "Monitor", "Critical"] },
        "fibre_stock_t": { "type": "number" },
        "next_harvest_date": { "type": "string" }
      },
      "required": ["district", "bamboo_stock_t", "coverage_pct", "status", "fibre_stock_t", "next_harvest_date"]
    },
    "HarvestRecommendation": {
      "title": "Harvest Recommendation",
      "description": "AI-generated harvest advice for a district.",
      "type": "object",
      "properties": {
        "district": { "type": "string" },
        "species": { "type": "string" },
        "age_years": { "type": "number" },
        "season": { "type": "string" },
        "density": { "type": "number" },
        "recommendation_text": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["district", "species", "age_years", "season", "density", "recommendation_text", "created_at"]
    },
    "SHGActivity": {
      "title": "SHG Activity",
      "description": "Self-Help Group harvest activities and income.",
      "type": "object",
      "properties": {
        "cooperative_name": { "type": "string" },
        "district": { "type": "string" },
        "last_harvest_date": { "type": "string" },
        "volume_t": { "type": "number" },
        "income_inr": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Pending", "Inactive"] }
      },
      "required": ["cooperative_name", "district", "last_harvest_date", "volume_t", "income_inr", "status"]
    },
    "DSSAlert": {
      "title": "DSS Alert",
      "description": "System alerts for bamboo resource management.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "Warning", "Info"] },
        "description": { "type": "string" },
        "district": { "type": "string" },
        "detected_at": { "type": "string", "format": "date-time" },
        "action": { "type": "string" },
        "resolved": { "type": "boolean" }
      },
      "required": ["title", "severity", "description", "district", "detected_at", "action", "resolved"]
    }
  },
  "firestore": {
    "district_resources/{resourceId}": {
      "schema": "DistrictResource",
      "description": "District-level bamboo and fibre resource data."
    },
    "harvest_recommendations/{recId}": {
      "schema": "HarvestRecommendation",
      "description": "AI harvest recommendations logs."
    },
    "shg_activity/{activityId}": {
      "schema": "SHGActivity",
      "description": "Cooperative activity records."
    },
    "dss_alerts/{alertId}": {
      "schema": "DSSAlert",
      "description": "Resource alerts and warnings."
    }
  }
}
